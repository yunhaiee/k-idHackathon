# Server-only secrets (read ONLY in app/api/*+api.ts). Never commit.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
MODULATE_API_KEY=
FASTSPRING_API_USERNAME=
FASTSPRING_API_PASSWORD=
FASTSPRING_STORE=            # e.g. kardza.test.onfastspring.com (fill from FastSpring dashboard)
KID_SECRET_KEY=
KID_API_BASE=
INWORLD_API_KEY=             # optional (read-aloud for kids)

# Client-safe (k-ID says the publishable key is safe to ship)
EXPO_PUBLIC_KID_PUBLISHABLE_KEY=
EXPO_PUBLIC_KID_FAPI_BASE=
EXPO_PUBLIC_API_URL=         # optional: point native app at Cloud Run instead of the dev server
